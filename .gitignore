# Native libraries and APKs are local build/input artifacts. Regenerate native
# hooks from source and obtain the base APK from an entitled copy of the game.
*.so
*.apk

# Local media captures (including screenshots and recordings) must never be committed.
/media/

# Local demo captures (screen recordings of the running game contain copyrighted
# game audiovisual content and must stay local -- see COMPLIANCE.md "never add game
# assets or binaries to this repository").
/probe/

# Generated IL2CPP metadata dump. Regenerate locally from an entitled copy of
# the 9.2 APK; do not commit it.
/re_notes/dump.cs

