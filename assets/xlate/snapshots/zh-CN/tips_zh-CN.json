  "strings": [
    {
      "k": "ID_LOADING_TIPS_00",
      "v": "获取经验值来提升你的指挥官等级和壮大你的基地！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_01",
      "v": "如果感觉到任务变得困难，升级你的机器人。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_02",
      "v": "在基地的水晶提炼厂中领取免费水晶。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_03",
      "v": "重玩任务来探索其他路径。\n这绝不像看上去那么简单！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_04",
      "v": "记住格挡！\n格挡将显著地抵消即将到来的伤害。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_05",
      "v": "升阶来提高机器人能力效果，如破甲和流血！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_06",
      "v": "完成日常任务获取特定类别的火种！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_07",
      "v": "试过升阶吗？突袭其他指挥官的基地获取突袭货币 然后从突袭商店商店中购买火种。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_08",
      "v": "[F2B700FF]爆破系[-]机器人是爆炸伤害专家，可以加强\n特殊攻击以获得范围更大，更强力的爆炸效果。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_09",
      "v": "[0035ACFF]战术系[-] 机器人强大的协同作用和高超的策略帮助他们\n在战斗中适应敌人的力量。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_10",
      "v": "[782CB7FF]斗士系[-]机器人是披甲的盟友和狂怒的敌人\n不惜一切的重视力量。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_11",
      "v": "[E72B25FF]战士系[-]机器人拥有致命的精准\n并喜爱让敌人流失能量。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_12",
      "v": "[1D9312FF]侦察系[-] 机器人通过频繁的\n特殊攻击和高暴击快速击败对手。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_13",
      "v": "[109AC4FF]科技系[-]机器人制造护盾，操纵能量，\n并且装备着最先进的定制武器。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_14",
      "v": "机器人有六个类别:\n [1D9312FF]侦察系[-]、[109AC4FF]科技系[-]、[F2B700FF]爆破系[-]、[0035ACFF]战术系[-]、[782CB7FF]斗士系[-]和 [E72B25FF]战士系[-].",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_15",
      "v": "每个类别都能相互克制。\n选择适合的类别将提升你的机器人的优势。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_16",
      "v": "如果你的机器人在战斗中被击倒，\n使用复活让他们重新战斗。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_17",
      "v": "点击并长按完成一次重击。\n你的机器人的攻击突破了敌人的格挡！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_18",
      "v": "将矿-13的类别与机器人类别匹配以获得加成。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_19",
      "v": "当升阶时，一些特殊能力，如护甲加成或震击，\n将变得更强大。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_20",
      "v": "[1D9312FF]侦察系[-]机器人使出的迅猛攻击\n使他们在面对[109AC4FF]科技系[-]机器人时具有类别优势。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_21",
      "v": "[109AC4FF]科技系[-]机器人制造出的强大护盾使\n他们具有应对[F2B700FF]爆破系[-]机器人强力攻击的类别优势。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_22",
      "v": "更少、更大、更宽的攻击使[F2B700FF]爆破系[-]机器人\n在面对[0035ACFF]战术系[-]机器人时具有类别优势。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_23",
      "v": "[0035ACFF]战术系[-]机器人的反装甲能力帮助\n他们在应对[782CB7FF]斗士系[-]机器人时具有类别优势。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_24",
      "v": "低暴击高伤害使[782CB7FF]斗士系[-]机器人\n类别强于[E72B25FF]战士系[-]机器人。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_25",
      "v": "追踪系统使[E72B25FF]战士系[-]机器人\n类别强于[1D9312FF]侦察系[-]机器人",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_26",
      "v": "流血减益会使机器人流失能量，持续减少其生命值。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_27",
      "v": "机器人的段位、阶层、等级越高，提供的锻造经验值也越高。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_28",
      "v": "锻造机器人除了能获得锻造经验值外，还会提供矿-13、黄金和水晶碎片。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_29",
      "v": "最大锻造等级只能通过\n熔铸达到相应阶层的机器人才能解锁。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_30",
      "v": "机器人能获取锻造经验值进行提升。\n他们的锻造等级越高，提供的锻造经验值越多。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_31",
      "v": "[FFBA00FF]躲避：[-]向左滑动以躲避对手的近距离攻击。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_32",
      "v": "[FFBA00FF]冲刺：[-]向右滑动从远距离向对手发动冲刺。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_33",
      "v": "[FFBA00FF]回避：[-]向上或向下滑动来回避对手的远程攻击。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_34",
      "v": "[FFBA00FF]格挡：[-]长按屏幕左边来格挡，大幅度降低攻击造成的伤害！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_35",
      "v": "[FFBA00FF]连招：[-]使用轻击和普通攻击可制造更长的连招！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_36",
      "v": "[FFBA00FF]重击：[-]长按屏幕右侧来突破对手的格挡！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_37",
      "v": "[FFBA00FF]远程攻击：[-]点击屏幕右侧从远处发射飞弹！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_38",
      "v": "[FFBA00FF]特殊攻击：[-]化解或受到攻击时将获得能量。\n保存能量用来释放特殊攻击！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_39",
      "v": "一些机器人会在升阶时获得全新能力。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_40",
      "v": "[FFBA00FF]战斗提示：[-]别在对手格挡时浪费掉你的特殊攻击！\n因为他们将遭受较小伤害，而且随后能做出反击。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_41",
      "v": "加入同盟来参与同盟合作任务！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_42",
      "v": "加入同盟来参加同盟事件，并与你的朋友一起获得奖励！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_43",
      "v": "在任务中，节点之间的连线风格表明它是否被探索过。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_44",
      "v": "通过将机器人部署在基地防御中来获得黄金。\n稍后回来领取它们！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_45",
      "v": "基地防御中生成的黄金数量\n随机器人的级别和稀有度而增加。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_46",
      "v": "除了被偷窃之外，在突袭中战胜敌方机器人将获得突袭货币。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_47",
      "v": "通过基地的移动指挥部，来派遣机器人完成任务！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_48",
      "v": "护盾将保护你免受突袭和复仇。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_49",
      "v": "在护盾生效时进行突袭或复仇将移除护盾。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_50",
      "v": "复仇只能在被攻击后的短时间内进行，\n因此快速反击吧！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_51",
      "v": "即使是一次失败的袭击或复仇也将给对手\n一次报仇雪恨的机会。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_52",
      "v": "[FFBA00FF]战斗提示：[-]机器人使用特殊攻击时将无懈可击。\n等待对手特殊攻击结束，再予以反击！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_53",
      "v": "[FFBA00FF]战斗提示：[-]成功命中一到两次远程攻击后，立即向前冲刺并展开连击！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_54",
      "v": "[FFBA00FF]战斗提示：[-]暂停游戏，查看每个机器人可用技能的信息。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_55",
      "v": "[FFBA00FF]战斗提示：[-]对手靠近墙壁时尝试使用重击吧！\n他们在那种情况下将很难闪躲。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_56",
      "v": "[FFBA00FF]战斗提示：[-]在使用轻击和中等攻击命中对手后，\n尝试马上发动你的特殊攻击吧。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_57",
      "v": "[FFBA00FF]战斗提示：[-]对手冲刺到你面前时，\n你可以回避并反击！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_58",
      "v": "[FFBA00FF]战斗提示：[-]每次只有一个机器人可以使用特殊攻击！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_59",
      "v": "[FFBA00FF]战斗提示：[-]留神对手的特殊攻击槽。当他们具备发动特殊攻击的条件时，才是最危险的时候！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_60",
      "v": "[FFBA00FF]战斗提示：[-]别在对手格挡时浪费掉你的特殊攻击！\n因为他们将遭受较小伤害，而且随后能做出反击。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_61",
      "v": "在竞技场中与其他玩家的机器人进行战斗，以获得黄金和事件奖励！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_EXPLOREWORLD",
      "v": "探索这个未知的星球并收集那些你所喜爱而又具有代表性的机器人，来组建你的终极小队吧！",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_GIFT_A00",
      "v": "即使你已经加入一个同盟，你仍可以在同盟菜单中轻触搜索图示来搜索其他同盟。",
      "vn": 1
    },
    {
      "k": "ID_LOADING_TIPS_STARSCREAMFIGHT",
      "v": "学习如何战斗并打败红蜘蛛！用双手畅玩《变形金刚：百炼为战》才是王道！",
      "vn": 1
    },
