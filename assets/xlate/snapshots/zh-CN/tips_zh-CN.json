    },
    {
      "k": "ID_UI_INFOTIP_AVE_SELECTION_DIFFICULTY",
      "v": "难易度会控制敌人的强度和打败他们之后的奖励。",
      "vn": 1
    },
    {
      "k": "ID_UI_INFOTIP_AVE_SELECTION_EVENT_SCORE",
      "v": "对敌人造成伤害以赚取活动积分。战胜越困难的敌人获得的积分越高。",
      "vn": 1
    },
    {
      "k": "ID_UI_INFOTIP_AVE_SELECTION_MULTIPLIER",
      "v": "所选地图和难度上所有敌人的平均评分。",
      "vn": 1
    },
    {
      "k": "ID_UI_INFOTIP_AVE_SELECTION_PRESTIGE",
