    {
      "k": "ID_TUT_AWAYTEAMS_UNLOCKED",
      "v": "移动指挥部已解锁！",
      "vn": 1
    },
    {
      "k": "ID_TUT_BASE_COLLECT_SUBTITLE",
      "v": "并且用你的机器人再生资源！",
      "vn": 1
