  "signature": {
    "title_zh": "冷酷的嘲讽",
    "title_en": "Grim Mockery",
    "desc_zh": "如果敌人处于恐惧状态下，使用近战攻击被挽歌闪避，挽歌得到1层60%的攻击力增益，持续5秒。\n触发攻击力增益后，对方驱散恐惧的概率降低10%，直到下一次成功驱散恐惧后恢复。",
    "pua_icon": "E406",
    "ui_trigger": "none"
  },
  "special_attacks": {
    "sp1": {
      "name_zh": "忧郁导弹",
      "name_en": "Morose Missile",
      "desc_zh": "对方处于恐怖状态下时，此技能增加35%的伤害",
      "pua_icon": "E41C",
      "ui_trigger": "onSpecial1Hit",
      "effects": [
        {
          "title_zh": "特殊伤害",
          "title_en": "Special Damage",
          "desc_zh": "对方处于恐怖状态下时，此技能增加35%的伤害",
          "pua_icon": "E41C"
        }
      ]
    },
    "sp2": {
      "name_zh": "毁灭火箭",
      "name_en": "Ruinous Rocket",
      "desc_zh": "最后一击命中时施加燃烧，造成攻击力35%的伤害，持续4秒，如果敌人处于恐惧状态下，则造成攻击力70%的伤害，持续8秒",
      "pua_icon": "0xe41d",
      "ui_trigger": "onSpecial2Hit",
      "effects": [
        {
          "title_zh": "燃烧",
          "title_en": "Burn",
          "desc_zh": "最后一击命中时施加燃烧，造成攻击力35%的伤害，持续4秒，如果敌人处于恐惧状态下，则造成攻击力70%的伤害，持续8秒",
          "pua_icon": "0xe41d"
        }
      ]
    },
    "sp3": {
      "name_zh": "无处可逃",
      "name_en": "No Escape",
      "desc_zh": "技能完成后施加30秒的恐惧，此期间内恐惧无法被驱散，流血伤害强度翻倍。",
      "pua_icon": "E907",
      "ui_trigger": "onSpecial3Hit",
      "effects": [
        {
          "title_zh": "恐惧",
          "title_en": "Fear",
          "desc_zh": "技能完成后施加30秒的恐惧，此期间内恐惧无法被驱散，流血伤害强度翻倍。",
          "pua_icon": "E907"
        }
      ]
    }
  },
