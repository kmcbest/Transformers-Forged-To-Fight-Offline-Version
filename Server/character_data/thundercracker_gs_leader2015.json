    "sp3": {
      "name_zh": "毁灭性震击",
      "name_en": "Shocking Oblivion",
      "desc_zh": "最后一击施加1层震击，造成攻击力110%的伤害，持续6秒\n惊天雷身上每层近战增益额外增加2%的震击伤害\n对手身上身上每层增益额外增加5%的震击伤害",
      "pua_icon": "E914",
