  "game_abilities": [
    {
      "title_zh": "军火改装",
      "title_en": "Weapon Mod",
      "desc_zh": "每次发动重击时，构建一个随机的军火升级改装，构建时间为4秒。构建完成后，随机获得进攻/能量/防御改装中的一个。\n构建过程中若受到暴击攻击，构建将被打断。\n\n每个进攻升级增加30%攻击力，提升特殊技施加震击概率20%；\n每个防御升级增加20%伤害避免，提升特殊技施加眩晕概率20%；\n每个能量升级增加20%能量功率，提升特殊技施加能量流失概率20%。\n\n受到近战暴击时，将损失最新获得的一个改装。",
      "pua_icon": "E306",
      "category": "passive",
      "ui_trigger": "升级",
      "show_on_main_screen": false
    },
    {
      "title_zh": "黑市暴利",
      "title_en": "Windfall",
      "desc_zh": "当诈骗集齐三个同类升级改装时，立即激活应急纳米回血，恢复最大生命值的10%~20%。",
      "pua_icon": "E503",
      "category": "passive",
      "ui_trigger": "成功",
      "show_on_main_screen": false
    }
  ],
