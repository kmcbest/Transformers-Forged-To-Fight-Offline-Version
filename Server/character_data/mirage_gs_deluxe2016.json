  "signature": {
    "title_zh": "K.E.R.S",
    "title_en": "The Kinetic Energy Recovery System generates the following buffs when activating Special Attacks:",
    "desc_zh": "发动不同特殊技得到不同的加成\n\n特殊技1：远程攻击射速提升50%，持续19秒\n特殊技2：近战攻击变得无法防御，持续19秒\n特殊技3：获得90%的攻击加成，持续19秒",
    "pua_icon": "",
    "ui_trigger": "none"
  },
  "special_attacks": {
    "sp1": {
      "name_zh": "抢跑",
      "name_en": "Jump Start",
      "desc_zh": "进入破坏模式，该模式下远程攻击命中或被防有60%的概率扣除对方最大能量的9%",
      "pua_icon": "E41B",
      "ui_trigger": "onSpecial1Hit",
      "effects": [
        {
          "title_zh": "破坏模式",
          "title_en": "Disruption Mode",
          "desc_zh": "进入破坏模式，该模式下远程攻击命中或被防有60%的概率扣除对方最大能量的9%",
          "pua_icon": "E41B"
        }
      ]
    },
    "sp2": {
      "name_zh": "掌法和拳法",
      "name_en": "Sleight of Hand and Fist",
      "desc_zh": "进入失能模式，该模式下近战攻击每一击能施加1层攻击减益，降低对方4.75%的攻击力，持续20秒，最多叠加15层\n\n每施加7层攻击减益，眩晕对手1.5秒。",
      "pua_icon": "E41F",
      "ui_trigger": "onSpecial2Hit",
      "effects": [
        {
          "title_zh": "失能模式",
          "title_en": "Incapacitation Mode",
          "desc_zh": "进入失能模式，该模式下近战攻击每一击能施加1层攻击减益，降低对方4.75%的攻击力，持续20秒，最多叠加15层\n\n每施加7层攻击减益，眩晕对手1.5秒。",
          "pua_icon": "E41F"
        }
      ]
    },
    "sp3": {
      "name_zh": "借口",
      "name_en": "Pretense",
      "desc_zh": "进入敏捷模式，每次极限闪避对方攻击时，获得15%的永久攻击增益，最大堆叠20层。",
      "pua_icon": "E406",
      "ui_trigger": "onSpecial3Hit",
      "effects": [
        {
          "title_zh": "敏捷模式",
          "title_en": "Agility Mode",
          "desc_zh": "进入敏捷模式，每次极限闪避对方攻击时，获得15%的永久攻击增益，最大堆叠20层。",
          "pua_icon": "E406"
        }
      ]
    }
